          "old": "            local_prefix_steps=self.config.lookahead_depth,",
          "new": "            local_prefix_steps=self.config.lookahead_depth,\n            switch_action_min=env.graph.nl + 1,\n            switch_action_max=env.graph.action_count - 1,",
          "count": 1
        },
        {
          "old": "'maximum_initial_reachable_graph_service_in_every_slot'",
          "new": "'conservative_total_normal_demand_in_every_slot'",
