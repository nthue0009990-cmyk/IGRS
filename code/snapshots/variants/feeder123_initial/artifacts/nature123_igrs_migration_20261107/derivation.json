          "count": 1
        },
        {
          "old": "'maximum_reachable_graph_kw': self.max_graph_kw",
          "new": "'normal_demand_upper_bound_kw': self.max_graph_kw",
          "count": 1
        },
        {
          "old": "'actual_physical_points': self._points()",
          "new": "'logical_points': self._points(),\n                'actual_physical_points': self.oracle.physical_points",
